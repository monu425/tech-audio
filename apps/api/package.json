{
  "name": "@shop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "E-commerce REST API (Express 5, modular monolith)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/scripts/seed-admin.js",
    "seed:products": "node src/scripts/seed.js",
    "typecheck": "node --check src/server.js && node --check src/app.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shop/types": "*",
    "@shop/validation": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "pino": "^10.0.4",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
