# Storefront environment (copy to .env.local)

# Browser-facing API base (client lib/lib/api.ts). Keep it relative so requests
# stay same-origin and are proxied by next.config.ts rewrites. Inlined at build.
NEXT_PUBLIC_API_BASE=/api/v1

# Server-to-server API base used by Storefront Server Components at runtime.
# page.tsx + categories/page.tsx read API_BASE_URL; sitemap.ts + product pages
# read API_INTERNAL_URL. In a container these must point at the API service
# (e.g. http://api:4000/api/v1), never localhost.
API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

# Server-side proxy target used by Next rewrites for /api/* and /uploads/*
API_PROXY_TARGET=http://localhost:4000

# Public site origin (SEO metadata, canonical URLs). Inlined at build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
