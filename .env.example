# =====================================================================
# E-COMMERCE PLATFORM — ENVIRONMENT REFERENCE
# Copy the relevant block into the matching app's own .env file.
# Apps read:  apps/api/.env   apps/storefront/.env.local   apps/admin/.env.local
# Never commit real values. Placeholders only.
# =====================================================================

# ---------------------------------------------------------------------
# apps/api/.env
# ---------------------------------------------------------------------
NODE_ENV=development

# API server port
PORT=4000

# Public origin URLs (used for cookies, CORS, links in emails)
API_URL=http://localhost:4000
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# JWT secrets (use long random values in production)
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars

# Token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie settings
COOKIE_SECURE=false            # true behind HTTPS
COOKIE_SAME_SITE=lax

# CORS allowed origins (comma separated). The *.monkeycode-ai.live entries are
# included by default so preview domains are allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.monkeycode-ai.live,http://*.monkeycode-ai.live

# Argon2 password hashing params (leave empty for safe defaults)
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# SMTP for transactional email (OTP, password reset, order updates)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="E-Commerce <no-reply@example.com>"
MAIL_TRANSPORT=console        # console | smtp  (console prints to log for local dev)

# Admin bootstrap account (created by seed script). Keep in sync with
# apps/api/.env.example and the compose seed defaults.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------
# apps/storefront/.env.local   +   apps/admin/.env.local
# ---------------------------------------------------------------------
# Browser-facing API base (client lib/lib/api.ts). Keep it relative (/api/v1)
# so requests stay same-origin and are proxied to the API by the Next rewrites.
# NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_BASE=/api/v1

# Server-to-server API base read by Storefront Server Components at runtime
# (page.tsx + categories/page.tsx read API_BASE_URL; sitemap.ts + product pages
# read API_INTERNAL_URL). Defaults to http://localhost:4000/api/v1 when unset.
# In Docker these must point at the API service: http://api:4000/api/v1.
API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

# Server-side proxy target used by Next rewrites for /api/* and /uploads/*
# (defaults to http://localhost:4000 when unset; in Docker: http://api:4000)
API_PROXY_TARGET=http://localhost:4000

# Public site origin (SEO metadata, canonical URLs). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# docker-compose.yml (optional .env at repo root)
# ---------------------------------------------------------------------
# Compose reads this file for ${VAR} interpolation of the api/seed secrets only
# (ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET, COOKIE_SECURE, ADMIN_EMAIL,
# ADMIN_PASSWORD). Container-internal URLs (MONGODB_URI, STORE_URL, ADMIN_URL,
# CORS_ORIGINS, API_*_URL, API_PROXY_TARGET) are declared in docker-compose.yml
# itself. Do not put NEXT_PUBLIC_* in this root .env — those are per-app build
# args (see README -> Docker deployment), not compose .env values.
