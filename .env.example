# =====================================================================
# E-COMMERCE PLATFORM — ENVIRONMENT REFERENCE
# Copy the relevant block into the matching app's own .env file.
# Apps read:  apps/api/.env   apps/storefront/.env.local   apps/admin/.env.local
# Never commit real values. Placeholders only.
# =====================================================================

# ---------------------------------------------------------------------
# apps/api/.env
# ---------------------------------------------------------------------
NODE_ENV=development

# API server port
PORT=4000

# Public origin URLs (used for cookies, CORS, links in emails)
API_URL=http://localhost:4000
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# JWT secrets (use long random values in production)
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars

# Token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie settings
COOKIE_SECURE=false            # true behind HTTPS
COOKIE_SAME_SITE=lax

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Argon2 password hashing params (leave empty for safe defaults)
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# SMTP for transactional email (OTP, password reset, order updates)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="E-Commerce <no-reply@example.com>"
MAIL_TRANSPORT=console        # console | smtp  (console prints to log for local dev)

# Admin bootstrap account (created by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------
# apps/storefront/.env.local   +   apps/admin/.env.local
# ---------------------------------------------------------------------
# Public base URL of the backend API (browser-facing)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Server-side proxy target used by Next rewrites for /api/* in development
# (defaults to http://localhost:4000 when unset)
API_PROXY_TARGET=http://localhost:4000

# Public site origin (SEO metadata, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
