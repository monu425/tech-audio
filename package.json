{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready scalable e-commerce platform: storefront, admin dashboard, REST API, MongoDB",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "tsc -b packages/types packages/validation packages/utils",
    "watch:packages": "tsc -b -w packages/types packages/validation packages/utils",
    "db": "node scripts/dev-db.mjs",
    "dev": "concurrently -n api,store,admin -c blue,green,magenta \"npm:dev:api\" \"npm:dev:storefront\" \"npm:dev:admin\"",
    "dev:api": "npm run dev --workspace @shop/api",
    "dev:storefront": "npm run dev --workspace @shop/storefront",
    "dev:admin": "npm run dev --workspace @shop/admin",
    "build": "npm run build:packages && npm run build --workspace @shop/api && npm run build --workspace @shop/storefront && npm run build --workspace @shop/admin",
    "start": "npm run start --workspace @shop/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "backup": "node scripts/backup-mongo.mjs",
    "audit:security": "node scripts/security-audit.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
